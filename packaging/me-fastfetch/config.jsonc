{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ME-Logo als Banner oben (Vordergrund), darunter nur die wichtigsten Werte.
  // Farben/Quelle wie in der ME-Referenzconfig: 1 = ME-Cyan, 2 = Grau.
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/me-logo.txt",
    "position": "top",
    "color": { "1": "38;2;0;173;173", "2": "38;2;128;128;128" },
    "padding": { "top": 1, "left": 12, "right": 0 }
  },

  "display": {
    "separator": "  ",
    "key": { "width": 21, "paddingLeft": 12 },
    "percent": { "type": 3 },
    "bar": { "width": 8, "borderLeft": "", "borderRight": "", "charElapsed": "■", "charTotal": "·" },
    "color": { "keys": "38;2;0;173;173", "title": "1;38;2;0;173;173" },
    "constants": [
      "\u001b[1;38;2;0;173;173m",
      "\u001b[0m",
      "\u001b[38;2;128;128;128m"
    ]
  },

  "modules": [
    "break",
    { "type": "title",  "format": "            {$1}{user-name}{$3}@{$1}{host-name}{$2}" },
    { "type": "custom", "format": "            {$3}──────────────────────────────────────{$2}" },

    { "type": "host",    "key": "Host" },
    { "type": "os",      "key": "OS",     "format": "{2} {9} {$3}·{$2} {12}" },
    { "type": "kernel",  "key": "Kernel", "format": "{2}" },
    { "type": "uptime",  "key": "Uptime" },
    { "type": "cpu",     "key": "CPU",    "format": "{1} ({4}) · {8}", "temp": true },
    { "type": "memory",  "key": "RAM",    "format": "{4} {1} / {2}" },
    { "type": "disk",    "key": "Disk",   "format": "{13} {1} / {2}" },
    { "type": "localip", "key": "IP",     "showIpv4": true, "showMac": false }
  ]
}
