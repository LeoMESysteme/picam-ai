{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dispread:windows-bridge:release-manifest:1",
  "title": "Signed Windows bridge release manifest (external release prerequisite)",
  "description": "At most 65536 UTF-8 bytes, no duplicate keys. Ed25519 signs JSON without signature, sorted keys, compact separators, ASCII escapes. Sources must additionally match an application-provisioned HTTPS origin allowlist. No production key or host is supplied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "source_commit", "target", "artifacts", "signature"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target": {"const": "windows11-x64"},
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "description": "IDs must be unique; bridge-setup is required; aggregate size at most 4 GiB.",
      "contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "bridge-setup"}}},
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "url", "size", "sha256"],
        "properties": {
          "id": {"enum": ["bridge-setup", "usb-driver", "vcom-driver"]},
          "url": {"type": "string", "maxLength": 2048, "pattern": "^https://[a-z0-9.-]+(:443)?/[A-Za-z0-9/_.-]*$", "description": "No credentials/query/fragment/redirects, traversal segments, or percent escapes; exact provisioned origin required."},
          "size": {"type": "integer", "minimum": 1, "maximum": 2147483648},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$"},
        "value": {"type": "string", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{86}==$", "description": "Canonical base64 of exactly 64 signature bytes."}
      }
    }
  }
}
