# SSH-Schluesselpaar fuer den Remote-Zugang - gehoert nie ins Repo.
remoteclaude
remoteclaude.pub

# Projekt-venv (wird per install.sh mit --system-site-packages erzeugt)
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Laufzeit- und Diagnoseartefakte (Beispielausgaben, Sessions, Snapshots)
var/

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/.repowise/
/.vscode/
/.codex/
/.codegraph/
/.mcp.json
/.claude/
# Doku-Seite (Zensical-Prototyp)
/site/
/.venv-docs/
/docs-site/*
!/docs-site/api/
!/docs-site/assets/
# Lokaler Wrangler-Cache (enthält Account-ID)
/cloudflare/.wrangler/
